# ============================================================
# AnalyticsBot Environment Configuration
# ============================================================

# Target Dispatch Mode:
# 'callmebot' (Free personal WhatsApp gateway)
# 'waha' / 'webhook' (Free self-hosted WhatsApp Web microservice)
# 'telegram' (100% Free, instant setup with @BotFather, zero waiting or queue)
# 'discord' (100% Free instant channel webhook)
# 'cloud' (Official WhatsApp Cloud API)
# 'console' (Dry-run / local testing)
WHATSAPP_DISPATCH_MODE=console

# --- Option A: CallMeBot (Free Personal WhatsApp Alerts) ---
# 1. Send "I allow callmebot to send me messages" on WhatsApp to +34 644 44 44 44
# 2. Enter received apikey below:
CALLMEBOT_API_KEY=your_callmebot_api_key

# --- Option B: Telegram (Instant, 0 wait time, 0 card needed) ---
# 1. Message @BotFather on Telegram -> /newbot -> copy token
# 2. Message @userinfobot to get your numeric chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_numeric_chat_id

# --- Option C: Discord Webhook (Instant) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Option D: Local Webhook / WAHA (Self-hosted on PC or VM) ---
# Runs via Docker: `docker run -d -p 3000:3000 --name waha devlikeapro/waha`
WHATSAPP_WEBHOOK_URL=http://localhost:3000/api/sendText
WHATSAPP_WEBHOOK_AUTH_TOKEN=

# --- WhatsApp Cloud API Dispatch ---
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_cloud_api_access_token

# Recipient phone number in international E.164 format (e.g. +1234567890 or 1234567890@c.us)
WHATSAPP_RECIPIENT_PHONE=+1234567890

# --- Scheduler Settings ---
# Daily schedule time in 24h format (HH:MM), default is 09:00 AM
SCHEDULE_TIME=09:00
# Timezone (e.g., America/New_York, UTC, or system local)
SCHEDULER_TIMEZONE=America/New_York

# --- Analytics & Model Defaults ---
DEFAULT_CONSENSUS_LINE=3.5
LEAGUE_AVG_PACE=99.5
STEAL_RANK_PENALTY_THRESHOLD=5
STEAL_RANK_PENALTY_PCT=0.07
PERIMETER_DEF_TOP_THRESHOLD=5
PERIMETER_DEF_TOP_PENALTY_PCT=0.08
PERIMETER_DEF_BOTTOM_THRESHOLD=26
PERIMETER_DEF_BOTTOM_BOOST_PCT=0.08

# --- NBA API Settings ---
NBA_API_TIMEOUT_SECONDS=30
NBA_API_RETRY_COUNT=3
NBA_API_DELAY_BETWEEN_CALLS=1.0
